# ── Database ────────────────────────────────────────────────────────────────
# ADMIN role: owns the schema, creates tables/policies and the app_user role.
# On a fresh local Postgres this is usually your own superuser account.
ADMIN_DATABASE_URL=postgres://localhost:5432/postgres
DB_NAME=saas_starter
APP_DB_PASSWORD=app_password

# APP role: what the running app connects as. MUST be a non-superuser so that
# row-level security actually applies. Created by `npm run migrate`.
DATABASE_URL=postgres://app_user:app_password@localhost:5432/saas_starter

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000

# Public base URL, used for Stripe redirect + invite links.
APP_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to run in STUB mode: checkout is simulated
# locally so the whole app is demo-able without a Stripe account. Fill these in
# (test-mode keys) to use real Stripe Checkout, Billing Portal, and webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
